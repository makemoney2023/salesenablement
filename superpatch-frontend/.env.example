# ===========================================
# SuperPatch AI Call Center - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# Supabase (REQUIRED)
# ===========================================
# Public Supabase URL and anon key (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Bland.ai Voice Calls (REQUIRED)
# ===========================================
# API key for Bland.ai (server-side only)
BLAND_API_KEY=your-bland-api-key

# Memory ID for cross-call context (optional)
BLAND_MEMORY_ID=your-bland-memory-id
NEXT_PUBLIC_BLAND_MEMORY_ID=your-bland-memory-id

# Webhook URL where Bland.ai sends call results
# Defaults to Supabase Edge Function webhook-processor
NEXT_PUBLIC_BLAND_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/webhook-processor

# Outbound caller ID phone number (optional - Bland uses default if not set)
NEXT_PUBLIC_BLAND_FROM_NUMBER=+1234567890

# Webhook signature secret for verifying Bland.ai webhook payloads
# Set this in Supabase Edge Function secrets
# BLAND_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# Google Maps (REQUIRED for search)
# ===========================================
# Google Maps Places API key (server-side only)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# Cal.com Calendar Integration (REQUIRED for appointments)
# ===========================================
# Cal.com API key (server-side only)
CAL_API_KEY=your-cal-api-key

# Cal.com event type ID for demo bookings
CAL_EVENT_TYPE_ID=your-event-type-id

# Cal.com v2 API version header (required by /v2 endpoints; current value 2026-02-25)
# Header is named `cal-api-version` upstream — see https://cal.com/docs/api-reference/v2/bookings/create-a-booking
CAL_API_VERSION=2026-02-25

# ===========================================
# Firecrawl Website Enrichment (REQUIRED for enrichment)
# ===========================================
# Firecrawl API key (server-side only)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# ===========================================
# Google Gemini AI Analysis (REQUIRED for post-call analysis)
# ===========================================
# Set this in Supabase Edge Function secrets
# GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# Resend Email (REQUIRED for sample confirmations)
# ===========================================
# Set this in Supabase Edge Function secrets
# RESEND_API_KEY=your-resend-api-key

# ===========================================
# Site Configuration
# ===========================================
# Public URL for redirects (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Supabase Edge Function Secrets
# ===========================================
# These are set via Supabase dashboard or CLI, not in .env.local:
#
# SUPABASE_URL            - Auto-set by Supabase
# SUPABASE_SERVICE_ROLE_KEY - Auto-set by Supabase
# BLAND_API_KEY           - For retry queue processing
# BLAND_MEMORY_ID         - For retry queue processing
# BLAND_WEBHOOK_SECRET    - For webhook signature verification
# CAL_API_KEY             - For appointment booking (Cal.com v2)
# CAL_EVENT_TYPE_ID       - For appointment booking (must match canonical_ids.json)
# CAL_API_VERSION         - Cal.com v2 API version header (default: 2026-02-25)
# FIRECRAWL_API_KEY       - For practitioner enrichment
# GEMINI_API_KEY          - For call analysis
# RESEND_API_KEY          - For sample confirmation emails
# FROM_EMAIL              - Sender email (default: samples@superpatch.com)
# ALLOWED_ORIGIN          - CORS allowed origin (default: * - SET THIS IN PRODUCTION!)
# BUSINESS_TIMEZONE       - Business timezone (default: America/Toronto)
# WEBHOOK_URL             - Webhook processor URL for retry queue

# ===========================================
# Debug (optional)
# ===========================================
# DEBUG_SUPABASE=true
